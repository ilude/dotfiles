#!/usr/bin/env bash

set -euo pipefail

usage() {
    cat >&2 <<'EOF'
usage: pp [-p|--profile <name>] [--resume|--session <path-or-id>] [--] [pi arguments...]
EOF
    exit 2
}

profile="default"
pi_args=()
resume_session=""

while (($#)); do
    case "$1" in
        -p|--profile)
            (($# >= 2)) || usage
            profile="$2"
            shift 2
            ;;
        --profile=*)
            profile="${1#*=}"
            shift
            ;;
        --resume|--session)
            (($# >= 2)) || usage
            resume_session="$2"
            shift 2
            ;;
        --resume=*|--session=*)
            resume_session="${1#*=}"
            shift
            ;;
        --)
            shift
            pi_args+=("$@")
            break
            ;;
        *)
            pi_args+=("$1")
            shift
            ;;
    esac
done

if [[ ! "$profile" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || [[ "$profile" == "." ]] || [[ "$profile" == ".." ]]; then
    echo "pp: invalid profile name: $profile" >&2
    exit 2
fi

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
case "$profile" in
    default|legacy)
        profile_dir="${script_dir}/../pi/profiles/${profile}"
        if [[ ! -d "$profile_dir" ]]; then
            echo "pp: repository profile is not initialized: $profile" >&2
            echo "run scripts/migrate-pi-profiles.ps1 after closing Pi" >&2
            exit 1
        fi
        ;;
    *)
        profile_dir="${HOME}/.pi/profiles/${profile}"
        mkdir -p "$profile_dir"
        ;;
esac
profile_dir="$(cd "$profile_dir" && pwd)"
export PI_CODING_AGENT_DIR="$profile_dir"

if [[ -n "$resume_session" ]]; then
    pi_args=(--session "$resume_session" "${pi_args[@]}")
fi

TMPDIR=/tmp exec pi "${pi_args[@]}"
