#!/usr/bin/env bash

# Create the native Pi agent link to this repository's default profile.
# Physical agent directories are archived before removal. Link targets are preserved.
set -euo pipefail

DOTFILES_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
while [[ $# -gt 0 ]]; do
    case "$1" in
        --root)
            [[ $# -ge 2 ]] || {
                echo 'Error: --root requires a path' >&2
                exit 1
            }
            DOTFILES_DIR="$2"
            shift 2
            ;;
        *)
            echo "Error: Unknown argument: $1" >&2
            exit 1
            ;;
    esac
done
DOTFILES_DIR="$(cd -- "$DOTFILES_DIR" && pwd)"

# Junction operations must use native APIs, not MSYS directory/link emulation.
if [[ "${OSTYPE:-}" == msys* || "${OSTYPE:-}" == cygwin* || -n "${WINDIR:-}" ]]; then
    SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
    NATIVE_HOME="${HOME:-${USERPROFILE:-}}"
    [[ -n "$NATIVE_HOME" ]] || {
        echo 'Error: HOME or USERPROFILE is required' >&2
        exit 1
    }
    MSYS2_ARG_CONV_EXCL='*' pwsh -NoLogo -NoProfile -File "$(cygpath -w "$SCRIPT_DIR/pi-link-setup.ps1")" \
        -Root "$(cygpath -w "$DOTFILES_DIR")" -HomePath "$(cygpath -w "$NATIVE_HOME")"
    exit $?
fi

PI_SOURCE="$DOTFILES_DIR/pi/profiles/default"
PI_TARGET="$HOME/.pi/agent"
[[ -d "$PI_SOURCE" ]] || {
    echo "Error: Source directory not found: $PI_SOURCE" >&2
    exit 1
}
mkdir -p -- "$(dirname -- "$PI_TARGET")"

create_backup() {
    local source="$1" backup_name archive
    backup_name="pi-agent-backup-$(date +%Y%m%d-%H%M%S)"
    if command -v 7z &>/dev/null; then
        archive="$HOME/$backup_name.7z"
        if 7z a -mx=5 "$archive" "$source" >/dev/null 2>&1; then
            echo "Backup created: $archive"
            return 0
        fi
    fi
    archive="$HOME/$backup_name.tar.gz"
    if tar -czf "$archive" -C "$(dirname -- "$source")" "$(basename -- "$source")" 2>/dev/null; then
        echo "Backup created: $archive"
        return 0
    fi
    echo 'Error: Failed to create backup archive; agent directory preserved' >&2
    return 1
}

if [[ -L "$PI_TARGET" ]]; then
    if [[ "$PI_TARGET" -ef "$PI_SOURCE" ]]; then
        echo "$PI_TARGET: Already linked correctly"
        exit 0
    fi
    rm -- "$PI_TARGET"
elif [[ -d "$PI_TARGET" ]]; then
    create_backup "$PI_TARGET" || exit 1
    rm -rf -- "$PI_TARGET"
elif [[ -e "$PI_TARGET" ]]; then
    echo "Error: Agent path is not a directory or link: $PI_TARGET" >&2
    exit 1
fi

ln -s -- "$PI_SOURCE" "$PI_TARGET"
echo "$PI_TARGET: Symlink created -> $PI_SOURCE"
