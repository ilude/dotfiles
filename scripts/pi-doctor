#!/usr/bin/env bash

# Diagnostic snapshot of the Pi install health.
# Reports state only -- makes no changes.
# Exit 0 if all checks pass or only warn, exit 1 if any fail.

DOTFILES_DIR="${HOME}/.dotfiles"
PI_DIR="${DOTFILES_DIR}/pi"
PI_NODE_MODULES="${PI_DIR}/node_modules"
ONCLAVE_DIR="${DOTFILES_DIR}/onclave"
ONCLAVE_ADAPTER_DIR="${ONCLAVE_DIR}/extensions/onclave-pi"
PRIVATE_SECRETS_FILE="${DOTFILES_DIR}/private/secrets.env"
PRIVATE_ARCHIVE="${DOTFILES_DIR}/.dolos/artifacts/private.tar.gz.age"

PACKAGES=(
    "@earendil-works/pi-coding-agent"
    "@earendil-works/pi-agent-core"
    "@earendil-works/pi-ai"
    "@earendil-works/pi-tui"
    "typebox"
)

HAS_FAIL=0

ok()   { printf '  [ok]   %s\n' "$*"; }
warn() { printf '  [warn] %s\n' "$*"; }
fail() { printf '  [fail] %s\n' "$*"; HAS_FAIL=1; }

# Augment PATH with well-known install locations so the rest of the checks
# work even when invoked from a bare make environment (no interactive shell).
if [[ -z "${PNPM_HOME:-}" ]]; then
    if pnpm_path=$(command -v pnpm 2>/dev/null); then
        pnpm_path=$(readlink -f "$pnpm_path" 2>/dev/null || printf '%s\n' "$pnpm_path")
        pnpm_home_shell=$(dirname "$(dirname "$pnpm_path")")
        if command -v cygpath >/dev/null 2>&1; then
            PNPM_HOME=$(cygpath -w "$pnpm_home_shell" 2>/dev/null || printf '%s\n' "$pnpm_home_shell")
        else
            PNPM_HOME="$pnpm_home_shell"
        fi
    elif [[ -n "${LOCALAPPDATA:-}" ]] && command -v cygpath >/dev/null 2>&1; then
        PNPM_HOME="${LOCALAPPDATA}\\pnpm"
    else
        PNPM_HOME="${HOME}/.local/share/pnpm"
    fi
fi
export PNPM_HOME
if command -v cygpath >/dev/null 2>&1; then
    pnpm_home_shell=$(cygpath -u "$PNPM_HOME" 2>/dev/null || printf '%s\n' "$PNPM_HOME")
else
    pnpm_home_shell="$PNPM_HOME"
fi
PNPM_BIN="${pnpm_home_shell}/bin"
unset pnpm_home_shell

# fnm: pick highest version dir if present
FNM_NODE_BIN=""
fnm_versions_dir="${HOME}/.local/share/fnm/node-versions"
if [[ -d "$fnm_versions_dir" ]]; then
    fnm_latest=$(find "$fnm_versions_dir" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null | sort -V | tail -1)
    if [[ -n "$fnm_latest" ]]; then
        FNM_NODE_BIN="${fnm_versions_dir}/${fnm_latest}/installation/bin"
    fi
fi

# Prepend fallback dirs; duplicates in PATH are harmless.
PATH="${PNPM_BIN}:${FNM_NODE_BIN}:${PATH}"
export PATH

echo "Pi install health check"
echo "======================="

# 1. pi binary
echo ""
echo "pi binary"
if pi_path=$(command -v pi 2>/dev/null); then
    pi_version=$(pi --version 2>/dev/null || true)
    if [[ -n "$pi_version" ]]; then
        ok "pi at ${pi_path} -- version: ${pi_version}"
    else
        ok "pi at ${pi_path} (no --version flag)"
    fi
else
    fail "pi not found (checked PATH and ${PNPM_BIN})"
fi

# 2. pnpm global root
echo ""
echo "pnpm global root"
if pnpm_bin=$(command -v pnpm 2>/dev/null); then
    pnpm_global=$("$pnpm_bin" root -g 2>/dev/null || true)
    if [[ -n "$pnpm_global" && -d "$pnpm_global" ]]; then
        ok "${pnpm_global}"
    elif [[ -n "$pnpm_global" ]]; then
        fail "pnpm root -g returned ${pnpm_global} but directory does not exist"
    else
        fail "pnpm root -g returned nothing"
    fi
else
    fail "pnpm not found (checked PATH and ${PNPM_BIN})"
fi

# 3. Node
echo ""
echo "node"
if node_path=$(command -v node 2>/dev/null); then
    node_version=$(node --version 2>/dev/null || true)
    ok "${node_path} -- ${node_version}"
else
    fail "node not found (checked PATH and ${FNM_NODE_BIN:-no fnm dir found})"
fi

# 4. pi/node_modules symlinks
echo ""
echo "pi/node_modules symlinks"
for package in "${PACKAGES[@]}"; do
    link_path="${PI_NODE_MODULES}/${package}"
    if [[ -L "$link_path" ]]; then
        target=$(readlink -f "$link_path" 2>/dev/null || readlink "$link_path" 2>/dev/null || true)
        if [[ -d "$link_path" ]]; then
            ok "${package} -> ${target}"
        else
            fail "${package}: dangling symlink -> ${target:-unknown target}"
        fi
    elif [[ -e "$link_path" ]]; then
        warn "${package}: exists but is not a symlink"
    else
        warn "${package}: no symlink found in pi/node_modules"
    fi
done

# 5. Native deps ABI test
echo ""
echo "native deps ABI test"
if [[ -d "$PI_DIR" ]]; then
    if abi_error=$(cd "$PI_DIR" && node -e "require('web-tree-sitter'); require('tree-sitter-bash'); require('jsdom');" 2>&1); then
        ok "web-tree-sitter, tree-sitter-bash, jsdom all load"
    else
        fail "native module load failed"
        printf '         %s\n' "$abi_error"
        echo "         Suggestion: cd ~/.dotfiles && pnpm install --dir pi"
    fi
else
    fail "pi directory not found: ${PI_DIR}"
fi

# 6. ~/.pi/agent symlink
echo ""
pi_agent="${HOME}/.pi/agent"
echo "${HOME}/.pi/agent symlink"
if [[ -L "$pi_agent" ]]; then
    pi_agent_target=$(readlink -f "$pi_agent" 2>/dev/null || readlink "$pi_agent" 2>/dev/null || true)
    if [[ -d "$pi_agent" ]]; then
        ok "${pi_agent} -> ${pi_agent_target}"
    else
        fail "${pi_agent} is a dangling symlink -> ${pi_agent_target:-unknown target}"
    fi
elif [[ -e "$pi_agent" ]]; then
    warn "${pi_agent} exists but is not a symlink"
else
    fail "${pi_agent} does not exist (run scripts/pi-link-setup)"
fi

# 7. Onclave adapter source and workspace dependencies
echo ""
echo "Onclave adapter"
if [[ -f "${ONCLAVE_ADAPTER_DIR}/src/onclave-pi.ts" ]]; then
    ok "v2 adapter source is present"
else
    fail "adapter source missing (initialize the onclave submodule)"
fi
if [[ -d "${ONCLAVE_DIR}/node_modules" ]]; then
    if onclave_dep_error=$(cd "$ONCLAVE_ADAPTER_DIR" && node -e '
        const { createRequire } = require("node:module");
        const { join } = require("node:path");
        const requireFromAdapter = createRequire(join(process.cwd(), "package.json"));
        for (const name of ["amqplib", "@onclave/envelope", "typebox"]) requireFromAdapter.resolve(name);
    ' 2>&1); then
        ok "amqplib, @onclave/envelope, and typebox resolve"
    else
        fail "adapter dependencies do not resolve"
        printf '         %s\n' "$onclave_dep_error"
        echo "         Suggestion: pnpm install --dir ~/.dotfiles/onclave --frozen-lockfile"
    fi
else
    fail "Onclave workspace dependencies are missing"
    echo "         Suggestion: pnpm install --dir ~/.dotfiles/onclave --frozen-lockfile"
fi

# 8. Private secret bootstrap state
echo ""
echo "Onclave private configuration"
if [[ -f "$PRIVATE_SECRETS_FILE" ]]; then
    ok "private/secrets.env is present"
elif [[ -f "$PRIVATE_ARCHIVE" ]]; then
    fail "private/secrets.env is missing; run scripts/onclave-bootstrap.py"
else
    fail "private/secrets.env and the encrypted private archive are missing"
fi
if command -v bws >/dev/null 2>&1 && bws --version >/dev/null 2>&1; then
    ok "Bitwarden Secrets Manager CLI is installed and executable"
else
    fail "bws is missing or unusable (run scripts/install-bws.py --force)"
fi

# 9. Resolve the broker URL from an explicit override or BWS without printing it.
echo ""
echo "Onclave broker configuration"
onclave_url="${ONCLAVE_AMQP_URL:-}"
if [[ -z "$onclave_url" && -n "${BITWARDEN_ACCESS_KEY:-}" ]]; then
    if onclave_url=$(
        cd "$ONCLAVE_DIR" &&
            pnpm exec tsx - <<'TS'
import { loadBrokerUrlFromBws } from "./extensions/onclave-pi/src/lib/bws.ts";

loadBrokerUrlFromBws()
  .then((url) => {
    if (!url) process.exit(1);
    process.stdout.write(url);
  })
  .catch(() => process.exit(1));
TS
    ); then
        ok "broker credentials resolved from Bitwarden Secrets Manager"
    else
        fail "broker credentials could not be resolved from Bitwarden Secrets Manager"
    fi
fi

if [[ -z "$onclave_url" ]]; then
    fail "no explicit broker URL or BITWARDEN_ACCESS_KEY; the adapter will not start"
else
    export ONCLAVE_AMQP_URL="$onclave_url"
    if onclave_metadata=$(node <<'NODE'
const value = process.env.ONCLAVE_AMQP_URL;
try {
    const url = new URL(value);
    if (url.protocol !== "amqp:" && url.protocol !== "amqps:") process.exit(2);
    const port = url.port || (url.protocol === "amqps:" ? "5671" : "5672");
    const fields = [
        url.protocol.slice(0, -1),
        url.hostname,
        port,
        url.pathname || "/",
        url.username ? "yes" : "no",
        url.password ? "yes" : "no",
    ];
    process.stdout.write(fields.join("\t"));
} catch {
    process.exit(2);
}
NODE
    ); then
        IFS=$'\t' read -r onclave_scheme onclave_host onclave_port onclave_vhost onclave_user onclave_password <<<"$onclave_metadata"
        ok "scheme=${onclave_scheme} host=${onclave_host} port=${onclave_port} vhost=${onclave_vhost} username=${onclave_user} password=${onclave_password}"

        if node <<'NODE'
const net = require("node:net");
const url = new URL(process.env.ONCLAVE_AMQP_URL);
const port = Number(url.port || (url.protocol === "amqps:" ? 5671 : 5672));
const socket = net.createConnection({ host: url.hostname, port });
let settled = false;
const finish = (code) => {
    if (settled) return;
    settled = true;
    socket.destroy();
    process.exitCode = code;
};
socket.setTimeout(5000, () => finish(1));
socket.once("connect", () => finish(0));
socket.once("error", () => finish(1));
NODE
        then
            ok "broker TCP endpoint is reachable"
            if (
                cd "$ONCLAVE_ADAPTER_DIR" &&
                    pnpm exec tsx - <<'TS'
import { connect } from "amqplib";
import { CoreRpcClient } from "./src/lib/rpc-client.ts";

(async () => {
    const connection = await connect(process.env.ONCLAVE_AMQP_URL!);
    const channel = await connection.createChannel();
    const rpc = new CoreRpcClient(channel, 5000);
    await rpc.init();
    const response = await rpc.call({ op: "list_agents" });
    await channel.close();
    await connection.close();
    if (response.ok !== true) process.exit(1);
})().catch(() => process.exit(1));
TS
            ) >/dev/null 2>&1; then
                ok "broker authentication and Onclave core RPC succeeded"
            else
                fail "broker authentication or Onclave core RPC failed"
            fi
        else
            fail "broker TCP endpoint is not reachable"
        fi
    else
        fail "ONCLAVE_AMQP_URL is invalid or does not use amqp/amqps"
    fi
fi

echo ""
echo "======================="
if [[ $HAS_FAIL -eq 1 ]]; then
    echo "Result: FAIL (see [fail] items above)"
    exit 1
else
    echo "Result: OK"
    exit 0
fi
