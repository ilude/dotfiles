#!/usr/bin/env bash
#
# WSL Dotfiles Installer
# Installs dotfiles from Windows dotfiles repo into WSL environment
#
# Usage:
#   From Windows (PowerShell/cmd): wsl --cd ~ ~/.dotfiles/wsl/install
#   From WSL directly: /mnt/c/Users/<user>/.dotfiles/wsl/install
#
# Options:
#   --packages    Also install system packages (apt packages, zsh setup)
#   --help        Show this help message

set -e

# Configuration
DOTBOT_DIR="dotbot"
DOTBOT_BIN="bin/dotbot"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# Parse arguments
INSTALL_PACKAGES=false
for arg in "$@"; do
    case $arg in
        --packages)
            INSTALL_PACKAGES=true
            shift
            ;;
        --help|-h)
            echo "WSL Dotfiles Installer"
            echo ""
            echo "Usage: wsl/install [OPTIONS]"
            echo ""
            echo "Options:"
            echo "  --packages    Install system packages (apt, zsh, etc.)"
            echo "  --help        Show this help message"
            exit 0
            ;;
    esac
done

# The entrypoint owns its repository path. Running it from another directory must
# not select that directory's configuration.
find_dotfiles_dir() {
    local script_dir
    script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    local repo_dir
    repo_dir="$(cd "$script_dir/.." && pwd)"

    if [[ -f "$repo_dir/wsl/install.conf.yaml" ]]; then
        printf '%s\n' "$repo_dir"
        return 0
    fi

    return 1
}

BASEDIR=$(find_dotfiles_dir)

if [[ -z "$BASEDIR" ]]; then
    echo -e "${RED}Error: Could not find dotfiles directory${NC}"
    echo "Expected location: /mnt/c/Users/<username>/.dotfiles"
    exit 1
fi

echo -e "${CYAN}=== WSL Dotfiles Installer ===${NC}"
echo -e "Dotfiles directory: ${GREEN}$BASEDIR${NC}"
echo ""

# Check if running inside WSL
if [[ -z "$WSL_DISTRO_NAME" && ! -f /proc/sys/fs/binfmt_misc/WSLInterop ]]; then
    echo -e "${YELLOW}Warning: This script is designed to run inside WSL${NC}"
    echo "Current environment may not be WSL."
    echo ""
fi

# Change to the repository before resolving its managed dependencies.
cd "$BASEDIR"
CONFIG="$BASEDIR/wsl/install.conf.yaml"
DOTBOT_PATH="$BASEDIR/$DOTBOT_DIR/$DOTBOT_BIN"

# Initialize the submodules needed by Dotbot and the Pi Onclave adapter.
if [[ -d ".git" ]]; then
    echo -e "${YELLOW}Initializing required submodules...${NC}"
    git submodule sync --quiet --recursive
    git submodule update --init --recursive "${DOTBOT_DIR}" onclave
fi

if [[ ! -f "$DOTBOT_PATH" ]]; then
    echo -e "${RED}Error: Dotbot is unavailable at $DOTBOT_PATH.${NC}"
    echo "Initialize the dotbot submodule, then rerun wsl/install."
    exit 1
fi

if command -v python3 &>/dev/null; then
    PYTHON="python3"
elif command -v python &>/dev/null; then
    PYTHON="python"
else
    echo -e "${RED}Error: Python not found. Install python3, then rerun wsl/install.${NC}"
    exit 1
fi

# Handle ~/.claude - backup if directory, remove to allow symlink
if [[ -d "$HOME/.claude" && ! -L "$HOME/.claude" ]]; then
    BACKUP_FILE="$HOME/.claude-backup-$(date +%Y%m%d-%H%M%S).tar.gz"
    echo -e "${YELLOW}Backing up existing ~/.claude to ${BACKUP_FILE}${NC}"
    tar -czf "$BACKUP_FILE" -C "$HOME" .claude
    rm -rf "$HOME/.claude"
    echo -e "${GREEN}Backup created, removed ~/.claude directory${NC}"
elif [[ -L "$HOME/.claude" ]]; then
    # Remove old symlink to allow dotbot to recreate.
    rm -f "$HOME/.claude"
fi

echo -e "${CYAN}Running dotbot...${NC}"
if "$PYTHON" "$DOTBOT_PATH" -d "$BASEDIR" -c "$CONFIG" "${@}"; then
    echo -e "${GREEN}Dotbot completed successfully!${NC}"
else
    echo -e "${RED}Error: Dotbot failed.${NC}"
    exit 1
fi

# Install packages if requested
if [[ "$INSTALL_PACKAGES" == "true" ]]; then
    echo ""
    echo -e "${CYAN}Installing system packages...${NC}"

    PACKAGES_SCRIPT="$BASEDIR/wsl/packages"
    if [[ ! -f "$PACKAGES_SCRIPT" ]]; then
        echo -e "${RED}Error: WSL package installer is unavailable at $PACKAGES_SCRIPT.${NC}"
        exit 1
    fi
    bash "$PACKAGES_SCRIPT"
fi

echo ""
echo -e "${CYAN}Installing Bitwarden Secrets Manager CLI...${NC}"
"$PYTHON" "$BASEDIR/scripts/install-bws.py"

echo ""
echo -e "${CYAN}Restoring Onclave private configuration...${NC}"
"$PYTHON" "$BASEDIR/scripts/onclave-bootstrap.py"

echo ""
echo -e "${GREEN}=== WSL Setup Complete ===${NC}"
echo ""
echo "If zsh isn't your default shell, run: chsh -s \$(which zsh)"
echo ""
