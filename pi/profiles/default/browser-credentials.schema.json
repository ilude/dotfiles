{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/pi/browser-credentials.schema.json",
  "title": "Local browser credential bindings",
  "description": "Identity-free schema for ignored browser-credentials.json in one active Pi profile. Bindings identify one exact BWS record and allowed page/frame origins and field purposes. If a form destination is available, form_origins can restrict it; absence of a form destination does not broaden page, frame, or field bindings. This schema does not authorize a site to be trusted against compromised same-origin scripts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "bindings"],
  "properties": {
    "version": { "const": 1 },
    "bindings": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["record_id", "expected_key", "origins", "fields"],
        "properties": {
          "record_id": { "type": "string", "minLength": 1 },
          "expected_key": { "type": "string", "minLength": 1 },
          "origins": { "$ref": "#/$defs/origins" },
          "frame_origins": { "$ref": "#/$defs/origins" },
          "form_origins": { "$ref": "#/$defs/origins" },
          "fields": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  },
  "$defs": {
    "origins": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^https?://[^/]+$" },
      "uniqueItems": true
    }
  }
}
