{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "typeRoots": [
      "../../legacy/node_modules/@types"
    ],
    "baseUrl": ".",
    "paths": {
      "@earendil-works/pi-coding-agent": [
        "../../legacy/node_modules/@earendil-works/pi-coding-agent/dist/index.d.ts"
      ],
      "@earendil-works/pi-ai": [
        "../../legacy/node_modules/@earendil-works/pi-ai/dist/index.d.ts"
      ],
      "typebox": [
        "../../legacy/node_modules/typebox/build/index.d.mts"
      ]
    }
  },
  "include": [
    "../extensions/web-tools/*.ts"
  ]
}
