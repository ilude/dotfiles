# Environment secrets - copy to .env and fill in values
# This file is sourced by .zshrc on shell startup
# .env is gitignored - never commit actual secrets

# =============================================================================
# YouTube Skill (claude/skills/youtube-transcript)
# =============================================================================
# Webshare proxy credentials for transcript fetching
# Get credentials at: https://www.webshare.io/
# export WEBSHARE_PROXY_USERNAME=your_username
# export WEBSHARE_PROXY_PASSWORD=your_password

# YouTube Data API v3 key for metadata fetching
# Get API key at: https://console.cloud.google.com/apis/credentials
# export YOUTUBE_API_KEY=your_api_key

# Internal service domain used to derive https://menos.<domain>/api/v1
# export HOST_DOMAIN=example.net

# Optional menos API endpoint override
# export MENOS_API_BASE=https://menos.example.net/api/v1

# =============================================================================
# Add new secrets below as needed
# =============================================================================
# Example format:
# export SERVICE_API_KEY=your_key_here
