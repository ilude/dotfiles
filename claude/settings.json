{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_TELEMETRY": "1",
    "CLAUDE_CODE_USE_BEDROCK": "1",
    "AWS_REGION": "us-east-2",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "us.anthropic.claude-opus-5-5"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(pi-run:*)",
      "Bash(~/.dotfiles/scripts/pi-run:*)",
      "Bash(pi -p:*)",
      "Bash(pi --list-models:*)"
    ],
    "ask": [
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)"
    ]
  },
  "enableAllProjectMcpServers": false,
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python $HOME/.claude/hooks/allow-claude-dir.py",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python $HOME/.claude/hooks/notify/notification-sound.py",
            "timeout": 2
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "python $HOME/.claude/hooks/quality-validation/quality_validation_hook.py",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python $HOME/.claude/hooks/quality-validation/quality_validation_hook.py",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python $HOME/.claude/hooks/commit-guard/commit_guard_hook.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun $HOME/.claude/hooks/damage-control/pi-adapter.ts",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python $HOME/.claude/hooks/path-normalization/path-normalization-hook.py",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bun $HOME/.claude/hooks/damage-control/pi-adapter.ts",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "python $HOME/.claude/hooks/path-normalization/path-normalization-hook.py",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bun $HOME/.claude/hooks/damage-control/pi-adapter.ts",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python $HOME/.claude/hooks/team_cleanup.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"C:\\Users\\mglenn\\.claude\\hooks\\herdr-agent-state.ps1\" session",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python $HOME/.claude/hooks/session-history/session_history_hook.py",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "python $HOME/.claude/claude-status"
  },
  "enabledPlugins": {
    "aws-agentic-ai@aws-skills": true,
    "aws-cdk@aws-skills": true,
    "aws-cost-ops@aws-skills": true,
    "handbook-git-worktree@cc-handbook": true,
    "handbook-glab@cc-handbook": true,
    "serverless-eda@aws-skills": true,
    "superpowers@superpowers-marketplace": true
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "medium",
  "companyAnnouncements": [],
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "releaseChannel": "latest"
}
